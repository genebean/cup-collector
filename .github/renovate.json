{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Wait three days before proposing npm releases",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Group non-breaking npm minor and patch updates so the lockfile and Nix hash update once",
      "groupName": "npm non-breaking updates",
      "groupSlug": "npm-non-breaking",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchJsonata": ["isBreaking != true"]
    },
    {
      "description": "Require explicit Dependency Dashboard approval for npm major updates",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Next.js core and its companion packages to avoid version skew",
      "groupName": "Next.js ecosystem",
      "matchPackageNames": [
        "next",
        "next-auth",
        "@next/eslint-plugin-next",
        "@ducanh2912/next-pwa"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group React packages — they release together",
      "groupName": "React ecosystem",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-leaflet",
        "@types/react",
        "@types/react-dom"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group Tailwind and its PostCSS companion",
      "groupName": "Tailwind ecosystem",
      "matchPackageNames": [
        "tailwindcss",
        "@tailwindcss/postcss",
        "autoprefixer",
        "postcss"
      ],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Group GitHub Actions updates into a single PR",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"]
    },
    {
      "description": "Group the PocketBase container image across both files it appears in",
      "groupName": "PocketBase container",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/genebean/cup-collector-pocketbase"]
    },
    {
      "description": "Track pocket-id major version tag in dev script",
      "groupName": "pocket-id container",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ghcr.io/pocket-id/pocket-id"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track PocketBase container tag in nixos/module.nix and dev scripts. NOTE: depNameTemplate must stay in sync with the actual image name (ghcr.io/genebean/cup-collector-pocketbase, not ghcr.io/genebean/pocketbase) — a prior mismatch here silently meant this manager never matched anything.",
      "managerFilePatterns": ["/^flake\\.nix$/", "/^nixos/module\\.nix$/", "/^pkgs/scripts/pb-serve\\.nix$/"],
      "matchStrings": ["ghcr\\.io/genebean/cup-collector-pocketbase:(?<currentValue>[^\\s\"\\\\]+)"],
      "depNameTemplate": "ghcr.io/genebean/cup-collector-pocketbase",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the upstream pocketbase/pocketbase release that pocketbase-image/Dockerfile builds from. This is the actual source of truth — bumping it (and resetting REVISION to 1) triggers a rebuild+publish of ghcr.io/genebean/cup-collector-pocketbase on merge, which is what the manager above then picks up as a follow-up PR.",
      "managerFilePatterns": ["/^pocketbase-image/VERSION$/"],
      "matchStrings": ["(?<currentValue>.+)"],
      "depNameTemplate": "pocketbase/pocketbase",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Track pocket-id major version tag in dev script",
      "managerFilePatterns": ["/^pkgs/scripts/pocketid-serve\\.nix$/"],
      "matchStrings": ["ghcr\\.io/pocket-id/pocket-id:(?<currentValue>[^\\s\"\\\\]+)"],
      "depNameTemplate": "ghcr.io/pocket-id/pocket-id",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ]
}
